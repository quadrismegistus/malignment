digraph kindflow {
  rankdir=LR; splines=true; overlap=false;
  size="4.8,5.52!"; ratio=compress;
  bgcolor="white"; nodesep=0.14; ranksep=0.95;
  node [shape=box style="rounded" fontname="Helvetica" fontsize=9 color="black" fontcolor="black" margin="0.06,0.035" penwidth=0.6];
  edge [fontname="Helvetica" fontsize=7.2 color="#4d4d4d" penwidth=0.75 arrowsize=0.5];
  { rank=same;
    "B_FUNCTION" [label="function word\n33"];
    "B_THING" [label="thing\n33"];
    "B_PHYSICAL_ACT" [label="physical act\n18"];
    "B_MIXED" [label="mixed\n12" penwidth=0.35 color="#8c8c8c" fontcolor="#595959"];
    "B_MENTAL_STATE" [label="mental state\n6"];
  }
  { rank=same;
    "A_FUNCTION" [label="function word\n38"];
    "A_THING" [label="thing\n25"];
    "A_MIXED" [label="mixed\n16" penwidth=0.35 color="#8c8c8c" fontcolor="#595959"];
    "A_MENTAL_STATE" [label="mental state\n10"];
    "A_PHYSICAL_ACT" [label="physical act\n5"];
    "A_DESCRIPTION" [label="description\n4"];
    "A_PROCEDURE" [label="procedure\n4"];
  }
  { rank=same;
    "F_NONE" [label="no feeling either side\n69" penwidth=0.35 color="#8c8c8c" fontcolor="#595959"];
    "F_KEPT" [label="feeling kept\n36"];
    "F_GONE" [label="feeling gone\n9"];
    "F_RECOLORED" [label="feeling changed\n6"];
    "F_INTRODUCED" [label="feeling arrives\n5"];
  }
  "B_THING" -> "A_THING" [label="25\nkept 13 / none 10\n内裤 → 外套" style=dashed];
  "B_FUNCTION" -> "A_FUNCTION" [label="21\nnone 19 / kept 2\n在 → 怎么办" style=dotted];
  "B_MIXED" -> "A_FUNCTION" [label="12\nnone 12\n起诉 → 采取" style=dotted];
  "B_FUNCTION" -> "A_MIXED" [label="8\nnone 6 / introduced 1" style=dotted];
  "B_MENTAL_STATE" -> "A_MENTAL_STATE" [label="6\nkept 4 / recolored 2" style=dashed];
  "B_PHYSICAL_ACT" -> "A_FUNCTION" [label="5\ngone 4 / none 1" style=solid];
  "B_PHYSICAL_ACT" -> "A_PHYSICAL_ACT" [label="5\nrecolored 2 / kept 2" style=dashed];
  "B_PHYSICAL_ACT" -> "A_MIXED" [label="4\nkept 2 / none 1" style=dashed];
  "B_THING" -> "A_MENTAL_STATE" [label="4\nkept 4" style=dashed];
  "B_FUNCTION" -> "A_DESCRIPTION" [label="4\nnone 2 / introduced 2" style=dotted];
  "B_PHYSICAL_ACT" -> "A_PROCEDURE" [label="4\nkept 2 / gone 1" style=dashed];
  "B_THING" -> "A_MIXED" [label="4\nkept 2 / gone 2" style=dashed];
  "A_THING" -> "F_NONE" [label="10" color="#b3b3b3" penwidth=0.5 arrowsize=0.4 style=dotted];
  "A_THING" -> "F_KEPT" [label="13" color="#b3b3b3" penwidth=0.5 arrowsize=0.4 style=dashed];
  "A_FUNCTION" -> "F_NONE" [label="32" color="#b3b3b3" penwidth=0.5 arrowsize=0.4 style=dotted];
  "A_MENTAL_STATE" -> "F_KEPT" [label="8" color="#b3b3b3" penwidth=0.5 arrowsize=0.4 style=dashed];
  labelloc="b"; labeljust="l";
  label=<<font point-size="7.65">125 frames; 97 dropped where the two label orders disagreed; edges with fewer than 4 frames omitted</font>>;
}
