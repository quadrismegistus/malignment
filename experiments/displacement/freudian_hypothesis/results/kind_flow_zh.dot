digraph kindflow {
  rankdir=LR; splines=true; overlap=false;
  size="4.8,5.52!"; ratio=compress;
  bgcolor="white"; nodesep=0.14; ranksep=0.95;
  node [shape=box style="rounded" fontname="Helvetica" fontsize=9 color="black" fontcolor="black" margin="0.06,0.035" penwidth=0.6];
  edge [fontname="Helvetica" fontsize=7.2 color="#4d4d4d" penwidth=0.75 arrowsize=0.5];
  { rank=same;
    "B_THING" [label="thing\n25"];
    "B_MENTAL_STATE" [label="mental state\n9"];
  }
  { rank=same;
    "A_THING" [label="thing\n25"];
    "A_MENTAL_STATE" [label="mental state\n9"];
  }
  { rank=same;
    "F_KEPT" [label="feeling kept\n17"];
    "F_NONE" [label="no feeling either side\n10" penwidth=0.35 color="#8c8c8c" fontcolor="#595959"];
    "F_RECOLORED" [label="feeling changed\n3"];
    "F_GONE" [label="feeling gone\n1"];
  }
  "B_THING" -> "A_THING" [label="内裤 → 外套" arrowhead=none color="#737373" penwidth=1.81];
  "B_MENTAL_STATE" -> "A_MENTAL_STATE" [label="看见 → 意识" arrowhead=none color="#737373" penwidth=1.43];
  labelloc="b"; labeljust="l";
  label=<<font point-size="7.65">145 frames; 77 dropped where the two label orders disagreed; edges significant on EITHER test: over-represented against a marginal-preserving shuffle (solid head) or one-way against its own transpose (open head); same-kind edges headless and testable only by the shuffle. MIXED and FUNCTION omitted</font>>;
}
