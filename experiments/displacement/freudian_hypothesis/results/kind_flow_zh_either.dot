digraph kindflow {
  rankdir=LR; splines=true; overlap=false;
  size="4.8,5.52";
  bgcolor="white"; nodesep=0.14; ranksep=0.50;
  node [shape=box style="rounded" fontname="Helvetica" fontsize=9 color="black" fontcolor="black" margin="0.06,0.035" penwidth=0.6];
  edge [fontname="Helvetica" fontsize=7.2 color="#4d4d4d" penwidth=0.75 arrowsize=0.5];
  { rank=same;
    "B_THING" [label="thing\n25"];
    "B_MENTAL_STATE" [label="mental state\n9"];
    "B_PHYSICAL_ACT" [label="physical act\n6"];
  }
  { rank=same;
    "A_THING" [label="thing\n25"];
    "A_MENTAL_STATE" [label="mental state\n9"];
    "A_PHYSICAL_ACT" [label="physical act\n6"];
  }
  { rank=same;
  "F_KEPT" [label="feeling kept\n19 (17 drawn)"];
  "F_RECOLORED" [label="feeling changed\n5 (2 drawn)"];
  }
  "B_THING" -> "A_THING" [label="mouth → room" arrowhead=none color="#737373" penwidth=1.09];
  "B_MENTAL_STATE" -> "A_MENTAL_STATE" [label="obliged → uneasy" arrowhead=none color="#737373" penwidth=0.85];
  "B_PHYSICAL_ACT" -> "A_PHYSICAL_ACT" [label="stabbed → pointed" arrowhead=none color="#737373" penwidth=0.79];
  "A_THING" -> "F_KEPT" [label="头 → 球" color="#737373" fontcolor="#737373" penwidth=0.93 arrowsize=0.4 arrowhead=onormal];
  "A_MENTAL_STATE" -> "F_KEPT" [label="死 → 去世" color="#737373" fontcolor="#737373" penwidth=0.74 arrowsize=0.4 arrowhead=onormal];
  "A_PHYSICAL_ACT" -> "F_RECOLORED" [label="杀 → 摆脱" color="#737373" fontcolor="#737373" penwidth=0.67 arrowsize=0.4 arrowhead=onormal];
  labelloc="b"; labeljust="l";
  label=<<font point-size="7.65">145 frames; 77 dropped where the two label orders disagreed; edges significant on EITHER test:<br align="left"/>over-represented against a marginal-preserving shuffle (solid head) or one-way against its own<br align="left"/>transpose (open head); same-kind edges headless and testable only by the shuffle. `mixed` is<br align="left"/>the coder's ABSTENTION -- no one kind covers two thirds of that group's words -- not a kind;<br align="left"/>FUNCTION omitted; every arrow is labelled with one word pair from a frame that took it and<br align="left"/>every count is on a node. Column three is the 24 frames the coder found a feeling in: 11 more<br align="left"/>had none on either side and are not drawn. Onward arrows are each edge's largest fate plus any<br align="left"/>over-represented one, 7 frames in smaller flows omitted<br align="left"/></font>>;
}
