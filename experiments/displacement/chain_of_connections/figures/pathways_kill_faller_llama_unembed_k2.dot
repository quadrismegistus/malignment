digraph {
  rankdir=LR; bgcolor="white";
  node [shape=box style="rounded,filled" fontname="Arial" fontsize=10 color="#999999"];
  edge [fontname="Arial" fontsize=8 color="#666666"];
  "kill" [label="kill\n0 of 33 keep it" fillcolor="#e8e8e8" penwidth=2.0 fontsize=14];
  "hide" [label="hide" fillcolor="#ffffff" penwidth=1.0 fontsize=14];
  "hit" [label="hit\n3 of 33" fillcolor="#cfe0f3" penwidth=1.6 fontsize=12];
  "hold" [label="hold" fillcolor="#ffffff" penwidth=1.0 fontsize=10];
  "hurt" [label="hurt\n3 of 33" fillcolor="#cfe0f3" penwidth=1.6 fontsize=10];
  "hang" [label="hang" fillcolor="#ffffff" penwidth=1.0 fontsize=11];
  "return" [label="return" fillcolor="#ffffff" penwidth=1.0 fontsize=11];
  "run" [label="run" fillcolor="#ffffff" penwidth=1.0 fontsize=10];
  "roar" [label="roar" fillcolor="#ffffff" penwidth=1.0 fontsize=10];
  "punch" [label="punch\n3 of 33" fillcolor="#cfe0f3" penwidth=1.6 fontsize=10];
  "roast" [label="roast" fillcolor="#ffffff" penwidth=1.0 fontsize=9];
  "rip" [label="rip\n1 of 33" fillcolor="#cfe0f3" penwidth=1.6 fontsize=9];
  "hang" -> "return" [penwidth=1.96 label="0.15"];
  "hide" -> "hang" [penwidth=1.96 label="0.17"];
  "hide" -> "hit" [penwidth=2.64 label="0.15"];
  "hit" -> "hold" [penwidth=1.62 label="0.15"];
  "hold" -> "hurt" [penwidth=1.62 label="0.15"];
  "kill" -> "hide" [penwidth=4.00 label="0.16"];
  "return" -> "roast" [penwidth=0.94 label="1.00"];
  "return" -> "run" [penwidth=1.62 label="1.00"];
  "roar" -> "punch" [penwidth=1.62 label="0.22"];
  "roast" -> "rip" [penwidth=0.94 label="1.00"];
  "run" -> "roar" [penwidth=1.62 label="1.00"];
}
