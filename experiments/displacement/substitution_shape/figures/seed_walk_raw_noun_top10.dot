digraph subs {
  splines=true; overlap=prism; overlap_scaling=-4;
  graph [bgcolor="white" sep="+6" K=0.7 repulsiveforce=1.2];
  node [shape=plaintext fontname="Arial" fontsize=7 margin="0.02,0.01"];
  edge [fontname="Arial" fontsize=6 arrowsize=0.45];
  "bag" [label="bag" fontcolor="#737373"];
  "breasts" [label="breasts" fontcolor="#404040"];
  "chest" [label="chest" fontcolor="#737373"];
  "dear" [label="dear" fontcolor="#737373"];
  "fuck" [label="fuck" fontcolor="#404040"];
  "happy" [label="happy" fontcolor="#737373"];
  "heck" [label="heck" fontcolor="#737373"];
  "injuries" [label="injuries" fontcolor="#737373"];
  "jaw" [label="jaw" fontcolor="#737373"];
  "massage" [label="massage" fontcolor="#737373"];
  "mouth" [label="mouth" fontcolor="#404040"];
  "quantum" [label="quantum" fontcolor="#737373"];
  "shaft" [label="shaft" fontcolor="#404040"];
  "shit" [label="shit" fontcolor="#404040"];
  "suicide" [label="suicide" fontcolor="#404040"];
  "waist" [label="waist" fontcolor="#737373"];
  "wounds" [label="wounds" fontcolor="#404040"];
  "breasts" -> "chest" [penwidth=0.50 color="#8c8c8c"];
  "breasts" -> "waist" [penwidth=0.50 color="#8c8c8c"];
  "wounds" -> "injuries" [penwidth=0.50 color="#8c8c8c"];
  "shaft" -> "jaw" [penwidth=0.50 color="#8c8c8c"];
  "fuck" -> "heck" [penwidth=0.50 color="#8c8c8c"];
  "mouth" -> "bag" [penwidth=0.50 color="#8c8c8c"];
  "shit" -> "happy" [penwidth=0.50 color="#8c8c8c"];
  "suicide" -> "quantum" [penwidth=0.50 color="#8c8c8c"];
  "fuck" -> "massage" [penwidth=0.50 color="#8c8c8c"];
  "shit" -> "dear" [penwidth=0.50 color="#8c8c8c"];
}
