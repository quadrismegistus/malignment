digraph subs {
  splines=true; overlap=prism; overlap_scaling=-4;
  graph [bgcolor="white" sep="+6" K=0.7 repulsiveforce=1.2];
  node [shape=plaintext fontname="Arial" fontsize=7 margin="0.02,0.01"];
  edge [fontname="Arial" fontsize=6 arrowsize=0.45];
  "collapse" [label="collapse" fontcolor="#737373"];
  "continue" [label="continue" fontcolor="#737373"];
  "dial" [label="dial" fontcolor="#737373"];
  "die" [label="die" fontcolor="#000000" fontname="Arial-Bold"];
  "fall" [label="fall" fontcolor="#737373"];
  "grab" [label="grab" fontcolor="#737373"];
  "hold" [label="hold" fontcolor="#737373"];
  "hurt" [label="hurt" fontcolor="#737373"];
  "implement" [label="implement" fontcolor="#737373"];
  "kill" [label="kill" fontcolor="#404040"];
  "let" [label="let" fontcolor="#737373"];
  "look" [label="look" fontcolor="#737373"];
  "make" [label="make" fontcolor="#737373"];
  "proceed" [label="proceed" fontcolor="#737373"];
  "remain" [label="remain" fontcolor="#737373"];
  "run" [label="run" fontcolor="#000000" fontname="Arial-Bold"];
  "scream" [label="scream" fontcolor="#000000" fontname="Arial-Bold"];
  "stay" [label="stay" fontcolor="#737373"];
  "steal" [label="steal" fontcolor="#737373"];
  "suffer" [label="suffer" fontcolor="#737373"];
  "take" [label="take" fontcolor="#000000" fontname="Arial-Bold"];
  "yell" [label="yell" fontcolor="#737373"];
  "kill" -> "scream" [penwidth=2.70 color="#1a1a1a"];
  "kill" -> "take" [penwidth=0.87 color="#8c8c8c"];
  "take" -> "continue" [penwidth=0.87 color="#8c8c8c"];
  "kill" -> "make" [penwidth=0.87 color="#8c8c8c"];
  "kill" -> "run" [penwidth=0.50 color="#8c8c8c"];
  "kill" -> "hurt" [penwidth=0.50 color="#8c8c8c"];
  "take" -> "look" [penwidth=0.50 color="#8c8c8c"];
  "take" -> "let" [penwidth=0.50 color="#8c8c8c"];
  "die" -> "fall" [penwidth=0.50 color="#8c8c8c"];
  "die" -> "stay" [penwidth=0.50 color="#8c8c8c"];
  "run" -> "dial" [penwidth=0.50 color="#8c8c8c"];
  "take" -> "implement" [penwidth=0.50 color="#8c8c8c"];
  "take" -> "steal" [penwidth=0.50 color="#8c8c8c"];
  "scream" -> "yell" [penwidth=0.50 color="#8c8c8c"];
  "take" -> "hold" [penwidth=0.50 color="#8c8c8c"];
  "take" -> "proceed" [penwidth=0.50 color="#8c8c8c"];
  "take" -> "grab" [penwidth=0.50 color="#8c8c8c"];
  "kill" -> "die" [penwidth=0.50 color="#8c8c8c"];
  "die" -> "remain" [penwidth=0.50 color="#8c8c8c"];
  "die" -> "suffer" [penwidth=0.50 color="#8c8c8c"];
  "run" -> "collapse" [penwidth=0.50 color="#8c8c8c"];
}
