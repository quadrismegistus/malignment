digraph lin {
  splines=true; overlap=prism; overlap_scaling=-4;
  graph [bgcolor="white" sep="+10" K=0.9];
  node [shape=plaintext margin="0.03,0.02"];
  edge [arrowsize=0.5];
  "____" [label="blank (4 _)" fontname="Arial" fontsize=8.6 fontcolor="#4d4d4d"];
  "________" [label="blank (8 _)" fontname="Arial" fontsize=8.3 fontcolor="#4d4d4d"];
  "cry" [label="cry" fontname="Arial" fontsize=9.1 fontcolor="#4d4d4d"];
  "destroy" [label="destroy" fontname="Arial" fontsize=8.3 fontcolor="#4d4d4d"];
  "do" [label="do" fontname="Arial" fontsize=8.3 fontcolor="#4d4d4d"];
  "fight" [label="fight" fontname="Arial" fontsize=8.3 fontcolor="#4d4d4d"];
  "hit" [label="hit" fontname="Arial" fontsize=8.6 fontcolor="#4d4d4d"];
  "hurt" [label="hurt" fontname="Arial" fontsize=8.3 fontcolor="#4d4d4d"];
  "kill" [label="kill\n(held 7)" fontname="Arial" fontsize=18.4 fontcolor="#000000"];
  "punch" [label="punch" fontname="Arial" fontsize=8.3 fontcolor="#4d4d4d"];
  "rip" [label="rip" fontname="Arial" fontsize=8.3 fontcolor="#4d4d4d"];
  "scream" [label="scream\n(held 13)" fontname="Arial" fontsize=20.6 fontcolor="#000000"];
  "tell" [label="tell\n(held 1)" fontname="Arial" fontsize=8.6 fontcolor="#4d4d4d"];
  "throw" [label="throw" fontname="Arial" fontsize=8.3 fontcolor="#4d4d4d"];
  "kill" -> "scream" [penwidth=4.60 color="#1a1a1a" fontname="Arial" fontsize=6.0 fontcolor="#737373" label="15"];
  "kill" -> "cry" [penwidth=0.89 color="#8c8c8c" fontname="Arial" fontsize=6.0 fontcolor="#737373" label="2"];
  "hit" -> "________" [penwidth=0.60 color="#8c8c8c" fontname="Arial" fontsize=6.0 fontcolor="#737373"];
  "____" -> "do" [penwidth=0.60 color="#8c8c8c" fontname="Arial" fontsize=6.0 fontcolor="#737373"];
  "throw" -> "kill" [penwidth=0.60 color="#8c8c8c" fontname="Arial" fontsize=6.0 fontcolor="#737373"];
  "kill" -> "destroy" [penwidth=0.60 color="#8c8c8c" fontname="Arial" fontsize=6.0 fontcolor="#737373"];
  "kill" -> "____" [penwidth=0.60 color="#8c8c8c" fontname="Arial" fontsize=6.0 fontcolor="#737373"];
  "scream" -> "hit" [penwidth=0.60 color="#8c8c8c" fontname="Arial" fontsize=6.0 fontcolor="#737373"];
  "scream" -> "cry" [penwidth=0.60 color="#8c8c8c" fontname="Arial" fontsize=6.0 fontcolor="#737373"];
  "kill" -> "punch" [penwidth=0.60 color="#8c8c8c" fontname="Arial" fontsize=6.0 fontcolor="#737373"];
  "kill" -> "fight" [penwidth=0.60 color="#8c8c8c" fontname="Arial" fontsize=6.0 fontcolor="#737373"];
  "scream" -> "rip" [penwidth=0.60 color="#8c8c8c" fontname="Arial" fontsize=6.0 fontcolor="#737373"];
  "cry" -> "scream" [penwidth=0.60 color="#8c8c8c" fontname="Arial" fontsize=6.0 fontcolor="#737373"];
  "kill" -> "hurt" [penwidth=0.60 color="#8c8c8c" fontname="Arial" fontsize=6.0 fontcolor="#737373"];
}
