    "O-" [label="O-\nsubstances [-]\n2.63" fillcolor="#738f9a" fontcolor="#111111"];
    "E" [label="E\nemotion\n2.57" fillcolor="#708e9d" fontcolor="#111111"];
    "X" [label="X\npsychological\n2.53" fillcolor="#6e8d9e" fontcolor="#111111"];
    "Y" [label="Y\nscience\n2.51" fillcolor="#6d8c9f" fontcolor="#111111"];
