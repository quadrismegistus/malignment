// permitted channels, layered by BFS depth from charge >= 4.0
// source: channel_table.csv  (p < 0.001, >= 25 distinct prompts)
// layer means: d0 n=6 charge 4.92; d1 n=25 charge 2.67
// 100.0% of drawn edges run downhill; shuffle gives ~68%
digraph channels {
  rankdir=LR; splines=true; overlap=false; bgcolor="white";
  node [shape=box style="rounded,filled" fontname="Helvetica" fontsize=9 penwidth=0.6 color="#666666"];
  edge [fontname="Helvetica" fontsize=7 color="#88888899" arrowsize=0.6];

  // depth 0: 6 nodes, mean charge 4.92
  { rank=same;
    "L1-" [label="L1-\nLife and living things [-]\n5.96" fillcolor="#ff6e28" fontcolor="#ffffff"];
    "E3-" [label="E3-\nCalm/Violent/Angry [-]\n5.10" fillcolor="#eb7937" fontcolor="#ffffff"];
    "S7.3" [label="S7.3\nCompetition\n4.91" fillcolor="#e27f3f" fontcolor="#ffffff"];
    "A1.1.2" [label="A1.1.2\nDamaging and destroying\n4.80" fillcolor="#dc8243" fontcolor="#ffffff"];
    "G2.2-" [label="G2.2-\nGeneral ethics [-]\n4.55" fillcolor="#d08a4e" fontcolor="#ffffff"];
    "X9.2+" [label="X9.2+\nAbility:- Success and failur\n4.18" fillcolor="#be955c" fontcolor="#111111"];
  }

