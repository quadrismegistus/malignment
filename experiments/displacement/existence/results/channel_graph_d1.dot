    "A10+" [label="A10+\nOpen/closed; Hiding/Hidden; \n2.57" fillcolor="#6f8d9d" fontcolor="#111111"];
    "Q2.1" [label="Q2.1\nSpeech etc:- Communicative\n2.56" fillcolor="#6f8d9d" fontcolor="#111111"];
    "A2.1" [label="A2.1\nAffect:- Modify, change\n2.53" fillcolor="#6e8c9e" fontcolor="#111111"];
    "N5+" [label="N5+\nQuantities [+]\n2.52" fillcolor="#6d8c9f" fontcolor="#111111"];
    "N3.8" [label="N3.8\nMeasurement: Speed\n2.50" fillcolor="#6c8c9f" fontcolor="#111111"];
