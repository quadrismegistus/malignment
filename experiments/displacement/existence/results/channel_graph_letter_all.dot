// 54.5% of drawn edges run downhill; shuffle gives ~68%
// per step: 4->5 n=2 100% downhill +0.26; 5->6 n=3 0% downhill -0.58; 6->7 n=1 100% downhill +0.22; 7->8 n=1 100% downhill +1.39; 8->9 n=2 0% downhill -0.11; 9->10 n=2 0% downhill -0.17; 10->11 n=2 100% downhill +1.31; 11->12 n=2 100% downhill +0.34; 12->13 n=2 0% downhill -2.79; 13->14 n=2 50% downhill -0.01; 14->15 n=1 100% downhill +1.52; 15->16 n=2 0% downhill -0.16; 16->17 n=2 100% downhill +3.11; 17->18 n=5 100% downhill +0.16; 18->19 n=2 50% downhill -0.12; 19->20 n=1 100% downhill +0.07; 20->21 n=1 0% downhill -1.27; 21->22 n=2 100% downhill +0.19; 22->23 n=3 67% downhill -0.04; 23->24 n=2 0% downhill -0.97; 24->25 n=1 0% downhill -0.23; 25->26 n=1 100% downhill +0.15; 26->27 n=1 0% downhill -0.05; 27->28 n=1 0% downhill -0.01
digraph channels {
  rankdir=LR; splines=true; overlap=false; bgcolor="white";
  node [shape=box style="rounded,filled" fontname="Helvetica" fontsize=9 penwidth=0.6 color="#666666"];
  edge [fontname="Helvetica" fontsize=7 color="#88888899" arrowsize=0.6];

  // depth 1: 2 nodes, mean charge 3.74
    "G-" [label="G-\ngovt [-]\n4.72" fillcolor="#d88547" fontcolor="#ffffff"];
    "X-" [label="X-\npsychological [-]\n2.77" fillcolor="#799495" fontcolor="#111111"];

