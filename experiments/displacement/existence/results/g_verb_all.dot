// 59.6% of drawn edges run downhill; shuffle gives ~68%
// per step: 6->7 n=1 100% downhill +0.36; 7->8 n=3 0% downhill -0.65; 8->9 n=3 100% downhill +0.30; 9->10 n=2 50% downhill +0.10; 10->11 n=3 100% downhill +2.28; 11->12 n=1 0% downhill -0.14; 12->13 n=3 0% downhill -0.29; 13->14 n=2 100% downhill +1.75; 14->15 n=2 50% downhill -1.03; 15->16 n=1 100% downhill +1.80; 16->17 n=1 0% downhill -0.72; 17->18 n=3 67% downhill +0.03; 18->19 n=2 0% downhill -0.43; 19->20 n=2 100% downhill +3.53; 20->21 n=4 100% downhill +0.37; 21->22 n=1 0% downhill -0.72; 22->23 n=3 67% downhill +0.19; 23->24 n=1 100% downhill +0.11; 24->25 n=1 0% downhill -0.56; 25->26 n=5 100% downhill +0.15; 26->27 n=1 100% downhill +0.24; 27->28 n=2 50% downhill -0.82; 28->29 n=2 0% downhill -0.12; 29->30 n=2 100% downhill +0.10; 30->31 n=4 25% downhill -0.40; 31->32 n=1 0% downhill -0.08; 32->33 n=1 100% downhill +0.10
digraph channels {
  rankdir=LR; splines=true; overlap=false; bgcolor="white";
  node [shape=box style="rounded,filled" fontname="Helvetica" fontsize=9 penwidth=0.6 color="#666666"];
  edge [fontname="Helvetica" fontsize=7 color="#88888899" arrowsize=0.6];

  // depth 2: 2 nodes, mean charge 3.31
    "S-" [label="SOCIAL [-]\nfight  removed  choked" fillcolor="#b09e68" fontcolor="#111111" width=1.18 height=0.57 fontsize=8.5];
    "N-" [label="NUMBERS [-]\nstepped  reduce  deduct  decline" fillcolor="#779296" fontcolor="#111111" width=1.34 height=0.64 fontsize=8.9];

