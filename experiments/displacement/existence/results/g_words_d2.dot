  "N+" -> "Y" [penwidth=0.73 label="all->it (44)"];
  "N+" -> "Z" [penwidth=0.51 label="also->the (45)"];
  "Q" -> "A" [penwidth=0.51 label="told->made (47)"];
  "Q" -> "E" [penwidth=0.90 label="say->feel (42)"];
  "Q" -> "T" [penwidth=0.63 label="told->then (47)"];
  "Q" -> "X" [penwidth=0.49 label="told->watched (47)"];
  "Q" -> "X+" [penwidth=0.58 label="said->tried (47)"];
  "T+" -> "O-" [penwidth=1.96 label="started->froze (20)"];
