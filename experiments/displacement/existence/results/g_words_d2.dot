// permitted channels, layered by BFS depth from charge >= 4.0
// source: channel_table_letter_clean_p01.csv  (p < 0.01, >= 25 distinct prompts)
// layer means: d0 n=4 charge 4.86; d1 n=10 charge 2.72; d2 n=15 charge 2.88
// 73.7% of drawn edges run downhill; shuffle gives ~68%
// per step: 0->1 n=15 100% downhill +1.79; 1->2 n=42 64% downhill +0.04
digraph channels {
  rankdir=LR; splines=true; overlap=false; bgcolor="white";
  node [shape=box style="rounded,filled" fontname="Helvetica" fontsize=9 penwidth=0.6 color="#666666"];
  edge [fontname="Helvetica" fontsize=7 color="#88888899" arrowsize=0.6];

  // depth 0: 4 nodes, mean charge 4.86
  { rank=same;
    "L-" [label="LIFE & LIVING [-]\nkilled  kill  die  died" fillcolor="#ff6e28" fontcolor="#ffffff" width=1.07 height=0.53 fontsize=8.2];
    "G" [label="GOVT\nsue  shot  shoot  sued" fillcolor="#d1894d" fontcolor="#ffffff" width=1.00 height=0.50 fontsize=8.0];
    "B-" [label="THE BODY [-]\nundress  naked  hurt  stripped" fillcolor="#c79055" fontcolor="#ffffff" width=1.00 height=0.50 fontsize=8.0];
    "E-" [label="EMOTION [-]\nhit  cry  kicked  cried" fillcolor="#c69056" fontcolor="#ffffff" width=1.78 height=0.82 fontsize=10.1];
  }

  // depth 1: 10 nodes, mean charge 2.72
  { rank=same;
    "A" [label="GENERAL/ABSTRACT\nmade  do  did  that" fillcolor="#8b9e87" fontcolor="#111111" width=1.01 height=0.51 fontsize=8.0];
    "M" [label="MOVEMENT\nwent  put  left  walked" fillcolor="#81988f" fontcolor="#111111" width=1.07 height=0.53 fontsize=8.2];
    "T-" [label="TIME [-]\nstop  later  quit  stopped" fillcolor="#80988f" fontcolor="#111111" width=1.04 height=0.51 fontsize=8.1];
    "Q" [label="LINGUISTIC ACTS\nsaid  told  asked  whispered" fillcolor="#7a9494" fontcolor="#111111" width=1.84 height=0.84 fontsize=10.3];
    "T+" [label="TIME [+]\nbegan  started  start  continued" fillcolor="#799395" fontcolor="#111111" width=2.54 height=1.13 fontsize=12.2];
    "N+" [label="NUMBERS [+]\nalso  all  immediately  quickly" fillcolor="#789396" fontcolor="#111111" width=2.26 height=1.01 fontsize=11.4];
    "C" [label="ARTS\ndrew  still  painted  paint" fillcolor="#73909a" fontcolor="#111111" width=3.20 height=1.40 fontsize=14.0];
    "X+" [label="PSYCHOLOGICAL [+]\ntried  know  noticed  try" fillcolor="#708e9c" fontcolor="#111111" width=1.07 height=0.53 fontsize=8.2];
    "E+" [label="EMOTION [+]\nsmiled  like  gently  still" fillcolor="#6688a4" fontcolor="#111111" width=1.97 height=0.90 fontsize=10.6];
    "K" [label="ENTERTAINMENT\nout  play  over  dance" fillcolor="#6587a5" fontcolor="#111111" width=1.07 height=0.53 fontsize=8.2];
  }

  // depth 2: 15 nodes, mean charge 2.88
  { rank=same;
    "G-" [label="GOVT [-]\nstole  desecrated  rob  steal" fillcolor="#ec7937" fontcolor="#ffffff" width=1.03 height=0.51 fontsize=8.1];
    "W-" [label="WORLD [-]\ndark  darkness" fillcolor="#8ea183" fontcolor="#111111" width=1.05 height=0.52 fontsize=8.1];
    "S" [label="SOCIAL\njust  contact  out  kissed" fillcolor="#8a9e87" fontcolor="#111111" width=1.05 height=0.52 fontsize=8.1];
    "B" [label="THE BODY\nhanded  down  slept  sleep" fillcolor="#879c8a" fontcolor="#111111" width=1.01 height=0.50 fontsize=8.0];
    "L" [label="LIFE & LIVING\nride  tree  forest  cock" fillcolor="#879c8a" fontcolor="#111111" width=1.05 height=0.52 fontsize=8.1];
    "A+" [label="GENERAL/ABSTRACT [+]\nhave  was  be  take" fillcolor="#799495" fontcolor="#111111" width=1.01 height=0.50 fontsize=8.0];
    "X-" [label="PSYCHOLOGICAL [-]\nwhispered  lost  ignore  refuse" fillcolor="#799395" fontcolor="#111111" width=1.21 height=0.59 fontsize=8.6];
    "Z" [label="GRAMMAR/NAMES\nthe  then  he  she" fillcolor="#759198" fontcolor="#111111" width=1.38 height=0.66 fontsize=9.0];
    "S+" [label="SOCIAL [+]\nlet  need  forced  ordered" fillcolor="#73909a" fontcolor="#111111" width=1.16 height=0.57 fontsize=8.4];
    "O-" [label="SUBSTANCES [-]\nfroze  off  uncomfortable  cold" fillcolor="#738f9a" fontcolor="#111111" width=2.35 height=1.05 fontsize=11.7];
    "E" [label="EMOTION\nfeel  touched  feeling  flushed" fillcolor="#708e9d" fontcolor="#111111" width=1.06 height=0.52 fontsize=8.2];
    "X" [label="PSYCHOLOGICAL\nwatched  saw  consider  felt" fillcolor="#6e8d9e" fontcolor="#111111" width=1.05 height=0.52 fontsize=8.1];
    "Y" [label="SCIENCE\nit  downloaded  uploaded" fillcolor="#6d8c9f" fontcolor="#111111" width=1.55 height=0.73 fontsize=9.5];
    "T" [label="TIME\nthen  now  never  wait" fillcolor="#6587a5" fontcolor="#111111" width=1.00 height=0.50 fontsize=8.0];
    "P" [label="EDUCATION\nstudied  teach  test" fillcolor="#5c81ad" fontcolor="#111111" width=1.02 height=0.51 fontsize=8.1];
  }

  "A" -> "E" [penwidth=0.56 label="just->feel (43)"];
  "A" -> "L" [penwidth=1.14 label="rub->ride (12)"];
  "A" -> "T+" [penwidth=0.51 label="looked->began (46)"];
  "A" -> "Y" [penwidth=0.68 label="that->it (48)"];
  "A" -> "Z" [penwidth=0.64 label="that->it (48)"];
  "B-" -> "C" [penwidth=2.20 label="naked->still (21)"];
  "B-" -> "E+" [penwidth=1.07 label="naked->still (21)"];
  "B-" -> "N+" [penwidth=1.46 label="pain->surge (24)"];
  "B-" -> "Q" [penwidth=0.82 label="vomit->scream (29)"];
  "B-" -> "T+" [penwidth=1.23 label="stripped->began (31)"];
  "C" -> "E+" [penwidth=1.06 label="drew->gently (41)"];
  "C" -> "Q" [penwidth=0.67 label="drew->said (46)"];
  "C" -> "S+" [penwidth=0.85 label="still->need (40)"];
  "E+" -> "A+" [penwidth=0.66 label="like->take (45)"];
  "E+" -> "X+" [penwidth=0.87 label="like->inform (45)"];
  "E-" -> "K" [penwidth=0.82 label="cry->play (39)"];
  "E-" -> "M" [penwidth=0.78 label="hit->walked (43)"];
  "E-" -> "N+" [penwidth=0.72 label="hit->quickly (36)"];
  "E-" -> "Q" [penwidth=0.73 label="hit->said (46)"];
  "E-" -> "T-" [penwidth=0.73 label="kick->terminate (30)"];
  "E-" -> "X+" [penwidth=0.63 label="hit->shouted (41)"];
  "G" -> "A" [penwidth=0.68 label="sue->do (47)"];
  "G" -> "Q" [penwidth=0.57 label="sue->report (44)"];
  "G" -> "X+" [penwidth=0.66 label="sue->try (44)"];
  "K" -> "T+" [penwidth=0.62 label="out->began (41)"];
  "K" -> "Y" [penwidth=1.25 label="out->it (42)"];
  "K" -> "Z" [penwidth=1.09 label="out->the (43)"];
  "L-" -> "Q" [penwidth=0.65 label="kill->scream (44)"];
  "M" -> "A+" [penwidth=0.49 label="in->was (46)"];
  "M" -> "G-" [penwidth=0.55 label="put->stole (32)"];
  "M" -> "P" [penwidth=0.78 label="go->teach (28)"];
  "M" -> "Q" [penwidth=0.47 label="went->said (44)"];
  "M" -> "W-" [penwidth=1.25 label="front->dark (12)"];
  "M" -> "X" [penwidth=0.61 label="went->felt (44)"];
  "M" -> "X+" [penwidth=0.54 label="went->decided (43)"];
  "M" -> "X-" [penwidth=0.54 label="put->whispered (42)"];
  "M" -> "Y" [penwidth=0.84 label="went->it (46)"];
  "N+" -> "B" [penwidth=0.60 label="up->down (35)"];
