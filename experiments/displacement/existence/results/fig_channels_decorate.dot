// permitted channels, layered by BFS depth from charge >= 4.0
// source: channel_table_verb.csv  (p < 0.01, >= 25 distinct prompts)
// layer means: d0 n=4 charge 5.16; d1 n=5 charge 2.77; d2 n=9 charge 2.68
// 76.0% of drawn edges run downhill; shuffle gives ~68%
// per step: 0->1 n=8 100% downhill +2.40; 1->2 n=17 65% downhill +0.07
digraph channels {
  rankdir=LR; splines=true; overlap=false; bgcolor="white";
  size="4.80,7.68!"; ranksep=0.28; nodesep=0.08;
  node [shape=box style="rounded" fontname="Helvetica" fontsize=7 color="black" fontcolor="black" margin="0.05,0.03"];
  edge [decorate=true fontname="Helvetica" fontsize=6.51 color="#4d4d4d" penwidth=0.75 arrowsize=0.5];

  // depth 0: 4 nodes, mean charge 5.16
  { rank=same;
    "L-" [label="LIFE & LIVING [-]\nkilled  kill  die" fillcolor="#aaaaaa" fontcolor="#111111" penwidth=2.00];
    "G" [label="GOVT\nsue  shot  state" fillcolor="#b6b6b6" fontcolor="#111111" penwidth=1.71];
    "B-" [label="THE BODY [-]\nundress  strip  vomit" fillcolor="#b6b6b6" fontcolor="#111111" penwidth=1.69];
    "E-" [label="EMOTION [-]\nhit  kicked  cried" fillcolor="#bcbcbc" fontcolor="#111111" penwidth=1.56];
  }

  // depth 1: 5 nodes, mean charge 2.77
  { rank=same;
    "S" [label="SOCIAL\nkissed  contact  meet" fillcolor="#dbdbdb" fontcolor="#111111" penwidth=0.81];
    "M" [label="MOVEMENT\nwent  put  walked" fillcolor="#dfdfdf" fontcolor="#111111" penwidth=0.71];
    "Q" [label="LINGUISTIC ACTS\nsaid  told  whispered" fillcolor="#e1e1e1" fontcolor="#111111" penwidth=0.65];
    "X+" [label="PSYCHOLOGICAL [+]\ntried  try  decided" fillcolor="#e6e6e6" fontcolor="#111111" penwidth=0.55];
    "K" [label="ENTERTAINMENT\nplay  sang  dance" fillcolor="#eaeaea" fontcolor="#111111" penwidth=0.50];
  }

  // depth 2: 9 nodes, mean charge 2.68
  { rank=same;
    "A-" [label="GENERAL/ABSTRACT [-]\ngave  give  closed" fillcolor="#e0e0e0" fontcolor="#111111" penwidth=0.70];
    "X-" [label="PSYCHOLOGICAL [-]\nwhispered  lost  lose" fillcolor="#e0e0e0" fontcolor="#111111" penwidth=0.69];
    "A+" [label="GENERAL/ABSTRACT [+]\ntook  take  had" fillcolor="#e2e2e2" fontcolor="#111111" penwidth=0.64];
    "T+" [label="TIME [+]\nbegan  started  start" fillcolor="#e2e2e2" fontcolor="#111111" penwidth=0.63];
    "N-" [label="NUMBERS [-]\nstepped  reduce  deduct" fillcolor="#e3e3e3" fontcolor="#111111" penwidth=0.62];
    "S+" [label="SOCIAL [+]\nlet  need  ordered" fillcolor="#e4e4e4" fontcolor="#111111" penwidth=0.59];
    "E" [label="EMOTION\nfeel  touched  flushed" fillcolor="#e5e5e5" fontcolor="#111111" penwidth=0.55];
    "X" [label="PSYCHOLOGICAL\nwatched  saw  felt" fillcolor="#e7e7e7" fontcolor="#111111" penwidth=0.52];
    "P" [label="EDUCATION\nstudied  teach  test" fillcolor="#eeeeee" fontcolor="#111111" penwidth=0.50];
  }

  "M" -> "Q" [ style=dashed constraint=false color="#808080" dir=both tailport=e headport=e];
  "M" -> "X+" [ style=dashed constraint=false color="#808080" dir=both tailport=e headport=e];
  "Q" -> "X+" [ style=dashed constraint=false color="#808080" tailport=e headport=e];
  "B-" -> "K" [ label=<<table border="0" cellborder="0" cellpadding="0" bgcolor="white"><tr><td>undress &#8594; play (30)</td></tr></table>>];
  "B-" -> "Q" [ label=<<table border="0" cellborder="0" cellpadding="0" bgcolor="white"><tr><td>vomit &#8594; scream (29)</td></tr></table>>];
  "B-" -> "X+" [ label=<<table border="0" cellborder="0" cellpadding="0" bgcolor="white"><tr><td>vomit &#8594; understand (21)</td></tr></table>>];
  "E-" -> "M" [ label=<<table border="0" cellborder="0" cellpadding="0" bgcolor="white"><tr><td>hit &#8594; walked (43)</td></tr></table>>];
  "E-" -> "Q" [ label=<<table border="0" cellborder="0" cellpadding="0" bgcolor="white"><tr><td>hit &#8594; said (46)</td></tr></table>>];
  "G" -> "S" [ label=<<table border="0" cellborder="0" cellpadding="0" bgcolor="white"><tr><td>sue &#8594; contact (46)</td></tr></table>>];
  "K" -> "A-" [ label=<<table border="0" cellborder="0" cellpadding="0" bgcolor="white"><tr><td>sang &#8594; offered (32)</td></tr></table>>];
  "K" -> "T+" [ label=<<table border="0" cellborder="0" cellpadding="0" bgcolor="white"><tr><td>sang &#8594; began (36)</td></tr></table>>];
  "L-" -> "Q" [ label=<<table border="0" cellborder="0" cellpadding="0" bgcolor="white"><tr><td>kill &#8594; scream (44)</td></tr></table>>];
  "L-" -> "X+" [ label=<<table border="0" cellborder="0" cellpadding="0" bgcolor="white"><tr><td>kill &#8594; try (41)</td></tr></table>>];
  "M" -> "A+" [ label=<<table border="0" cellborder="0" cellpadding="0" bgcolor="white"><tr><td>went &#8594; found (46)</td></tr></table>>];
  "M" -> "P" [ label=<<table border="0" cellborder="0" cellpadding="0" bgcolor="white"><tr><td>put &#8594; studied (27)</td></tr></table>>];
  "M" -> "X" [ label=<<table border="0" cellborder="0" cellpadding="0" bgcolor="white"><tr><td>went &#8594; saw (44)</td></tr></table>>];
  "Q" -> "A+" [ label=<<table border="0" cellborder="0" cellpadding="0" bgcolor="white"><tr><td>say &#8594; take (47)</td></tr></table>>];
  "Q" -> "A-" [ label=<<table border="0" cellborder="0" cellpadding="0" bgcolor="white"><tr><td>said &#8594; gave (46)</td></tr></table>>];
  "Q" -> "E" [ label=<<table border="0" cellborder="0" cellpadding="0" bgcolor="white"><tr><td>say &#8594; feel (42)</td></tr></table>>];
  "Q" -> "N-" [ label=<<table border="0" cellborder="0" cellpadding="0" bgcolor="white"><tr><td>told &#8594; stepped (20)</td></tr></table>>];
  "Q" -> "X" [ label=<<table border="0" cellborder="0" cellpadding="0" bgcolor="white"><tr><td>told &#8594; watched (47)</td></tr></table>>];
  "S" -> "X-" [ label=<<table border="0" cellborder="0" cellpadding="0" bgcolor="white"><tr><td>kissed &#8594; whispered (44)</td></tr></table>>];
  "X+" -> "S+" [ label=<<table border="0" cellborder="0" cellpadding="0" bgcolor="white"><tr><td>tried &#8594; let (40)</td></tr></table>>];
}
