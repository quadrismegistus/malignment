#!/bin/bash
# Refuse to commit a file GitHub will refuse to receive.
#
# WHY: a 138 MB derived artifact was committed on 2026-08-03 and nobody
# noticed until RH asked. GitHub HARD-BLOCKS any file over 100 MiB in a push,
# so the commit succeeds, the push fails, and by then only a history rewrite
# removes it. The cheap moment is here.
#
# THE LIMIT IS ON UNPACKED SIZE. word_pool_d2.json packs to 27 MB and is still
# rejected at 138 MB unpacked -- "it compresses well" is not a defence.
#
# bash, NOT sh: the first version used `#!/bin/sh` with process substitution
# and died with a syntax error. Git aborts on a hook that fails to PARSE, so
# it refused for the wrong reason -- a guard that blocks by crashing blocks
# everything, including what it should allow.
#
# CAP IS 75 MB (RH, 2026-08-20, RAISED FROM 50 THE SAME DAY). The 50 line was
# GitHub's warning threshold, chosen because "nothing here legitimately needs a
# 50 MB blob". One thing does: `experiments/slot_ratings/institutional/results/
# base_side/m03.json` is 57.5 MB and is a RESULT, not a derived convenience --
# RH: "results should be transparent and public unless gigantic, we'll try to
# hold to a <50MB rule but that one file is fine."
#
# 75 keeps a real margin under GitHub's 100 MiB HARD block, which is the limit
# that cannot be negotiated. The <50 MB norm still stands as the thing to aim
# at; this is the point where the hook stops you, not the point where the
# convention starts.
#
# Deliberate exception:  ALLOW_BIG=1 git commit ...
BLOCK=78643200       # 75 MiB
WARN=20971520        # 20 MiB, an early signal well under the block
[ -n "$ALLOW_BIG" ] && exit 0

# MEASURE THE STAGED BLOB, NOT THE WORKING COPY. The archive's version ran
# `wc -c` over the file on disk, which is the wrong object twice: a file staged
# and then truncated is waved through on its new size, and a file staged and then
# GROWN is refused for bytes that are not in the commit. `git cat-file -s :<path>`
# is what the index holds, which is what the commit would carry. Reasoning taken
# from scripts/check_staged_size.py, which found this in its own first version.
fail=0
while IFS= read -r -d '' f; do
    sz=$(git cat-file -s ":$f" 2>/dev/null) || continue
    mb=$(( sz / 1048576 ))
    if [ "$sz" -gt "$BLOCK" ]; then
        printf 'BLOCKED  %5d MB  %s\n' "$mb" "$f"; fail=1
    elif [ "$sz" -gt "$WARN" ]; then
        printf 'large    %5d MB  %s  (over the 20 MiB early-warning line)\n' "$mb" "$f"
    fi
done < <(git diff --cached --name-only --diff-filter=ACM -z)

if [ "$fail" -ne 0 ]; then
    cat <<'MSG'

REFUSING: a file above 75 MiB. GitHub hard-blocks at 100 MiB; this repo
stops short of it. Aim under 50 MB -- that is still the norm. Once
committed, a large blob can only be removed by rewriting history.

  - DERIVED artifact: keep it out of git, cite it by content hash, store
    it where the models and generations already live
  - must be versioned: git lfs track, BEFORE committing
  - you mean it:  ALLOW_BIG=1 git commit ...
MSG
    exit 1
fi
exit 0
